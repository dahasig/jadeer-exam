@{
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var showAdminNav = ViewData["ShowAdminNav"] as bool? == true;
    var showStaffNav = ViewData["ShowStaffNav"] as bool? == true;
    var showGradingNav = ViewData["ShowGradingNav"] as bool? == true;
}
<aside class="app-sidebar">
    @if (User.IsInRole("ADMIN") || User.IsInRole("EXAMINER"))
    {
        <a class="brand-block" asp-controller="Admin" asp-action="Operations">
            <span class="brand-logo-card">
                <span class="brand-logo-wrap"><partial name="_BrandLogo" /></span>
            </span>
            <div>
                <strong class="brand-title">@Localizer["app.brand"]</strong>
            </div>
        </a>
    }
    @if (User.IsInRole("GRADER"))
    {
        <a class="brand-block" asp-controller="Grading" asp-action="Grading">
            <span class="brand-logo-card">
                <span class="brand-logo-wrap"><partial name="_BrandLogo" /></span>
            </span>
            <div>
                <strong class="brand-title">@Localizer["app.brand"]</strong>
            </div>
        </a>
    }
    @if (User.IsInRole("CANDIDATE"))
    {
        <a class="brand-block" asp-controller="Home" asp-action="Dashboard">
            <span class="brand-logo-card">
                <span class="brand-logo-wrap"><partial name="_BrandLogo" /></span>
            </span>
            <div>
                <strong class="brand-title">@Localizer["app.brand"]</strong>
            </div>
        </a>
    }

    <partial name="_LangSwitcher" />

    <nav class="app-nav" aria-label="@Localizer["nav.main"]">
        @if (User.IsInRole("CANDIDATE"))
        {
            <a asp-controller="Home" asp-action="Dashboard"
               class="nav-item@(activeNav == "dashboard" ? " active" : "")">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
                </span>
                <span class="nav-label">@Localizer["nav.dashboard"]</span>
            </a>
        }
        @if (showAdminNav)
        {
            <a asp-controller="Admin" asp-action="Users"
               class="nav-item@(activeNav == "users" ? " active" : "")">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                </span>
                <span class="nav-label">@Localizer["nav.users"]</span>
            </a>
        }
        @if (showStaffNav)
        {
            <a asp-controller="Admin" asp-action="Operations"
               class="nav-item@(activeNav == "operations" ? " active" : "")">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                </span>
                <span class="nav-label">@Localizer["nav.exams"]</span>
            </a>
            <a asp-controller="Reports" asp-action="Reports"
               class="nav-item@(activeNav == "reports" ? " active" : "")">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
                </span>
                <span class="nav-label">@Localizer["nav.reports"]</span>
            </a>
        }
        @if (showGradingNav)
        {
            <a asp-controller="Grading" asp-action="Grading"
               class="nav-item@(activeNav == "grading" ? " active" : "")">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15h8v2H8v-2zm0-4h8v2H8v-2z"/></svg>
                </span>
                <span class="nav-label">@Localizer["nav.grading"]</span>
            </a>
        }
    </nav>

    <div class="sidebar-footer">
        <button type="button" class="nav-item nav-item-theme theme-toggle-slot" data-theme-trigger aria-label="@Localizer["theme.label.toggle"]">
            <span class="nav-icon theme-toggle-icon" aria-hidden="true">🌙</span>
            <span class="nav-label theme-toggle-label">@Localizer["theme.label.dark"]</span>
        </button>
        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-item nav-item-logout">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.59L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                </span>
                <span class="nav-label">@Localizer["nav.logout"]</span>
            </button>
        </form>
    </div>
</aside>
