        noFace: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.noFace"].Value)),
        faceAbsent: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.faceAbsent"].Value)),
        multipleFaces: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.multipleFaces"].Value)),
        gazeAway: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.gazeAway"].Value)),
        stressExpr: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.stressExpr"].Value)),
        faceUnavailable: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.faceUnavailable"].Value)),
        emotionHint: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.emotionHint"].Value)),
        cameraUnsupported: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.cameraUnsupported"].Value)),
        cameraUnsupportedDetail: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.cameraUnsupportedDetail"].Value)),
        cameraDenied: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.cameraDenied"].Value)),
        cameraDeniedDetail: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.cameraDeniedDetail"].Value)),
        cameraRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.cameraRequired"].Value)),
        loadingAnalysis: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.loadingAnalysis"].Value)),
        audioActive: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.audioActive"].Value)),
        tabSwitch: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.tabSwitch"].Value)),
        focusLoss: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.focusLoss"].Value)),
        copyBlocked: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.copyBlocked"].Value)),
        pasteBlocked: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.pasteBlocked"].Value)),
        rightClickBlocked: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.rightClickBlocked"].Value)),
        printBlocked: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.printBlocked"].Value)),
        devtools: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.devtools"].Value)),
        expr: {
            angry: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.expr.angry"].Value)),
            disgusted: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.expr.disgusted"].Value)),
            fearful: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.expr.fearful"].Value)),
            happy: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.expr.happy"].Value)),
            neutral: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.expr.neutral"].Value)),
            sad: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.expr.sad"].Value)),
            surprised: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["exam.mon.expr.surprised"].Value))
        }
    };
</script>
<script defer src="~/js/exam-calculator.js?v=@assetsVersion"></script>
<script defer src="~/js/monitoring-outbox.js?v=@assetsVersion"></script>
<script defer src="~/js/exam-monitor.js" asp-append-version="true"></script>
</body>
</html>
